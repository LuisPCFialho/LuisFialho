{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.luisfialho.com" }],
      "destination": "https://luisfialho.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "luisfialho.pt" }],
      "destination": "https://luisfialho.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.luisfialho.pt" }],
      "destination": "https://luisfialho.com/:path*",
      "permanent": true
    },
    {
      "source": "/euromilhoes",
      "destination": "/euromilhoes/",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/estatisticas/script.js", "destination": "https://analytics.openviewiptv.com/matomo.js" },
    { "source": "/estatisticas/registo", "destination": "https://analytics.openviewiptv.com/matomo.php" },
    {
      "source": "/euromilhoes/",
      "destination": "https://euromilhoes-luispcfialhos-projects.vercel.app/"
    },
    {
      "source": "/euromilhoes/:path*",
      "destination": "https://euromilhoes-luispcfialhos-projects.vercel.app/:path*"
    },
    {
      "source": "/ebook",
      "destination": "https://kilo-ebook.vercel.app/ebook"
    },
    {
      "source": "/ebook/",
      "destination": "https://kilo-ebook.vercel.app/ebook/"
    },
    {
      "source": "/ebook/:path*",
      "destination": "https://kilo-ebook.vercel.app/ebook/:path*"
    },
    {
      "source": "/carlife",
      "destination": "https://carlife-web.vercel.app/carlife"
    },
    {
      "source": "/carlife/",
      "destination": "https://carlife-web.vercel.app/carlife/"
    },
    {
      "source": "/carlife/:path*",
      "destination": "https://carlife-web.vercel.app/carlife/:path*"
    }
  ],
  "headers": [
    {
      "source": "/((?!ebook|carlife|euromilhoes|estatisticas).*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    }
  ]
}
